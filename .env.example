DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example,47.100.207.217
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_SECURE_COOKIES=1
DJANGO_TIME_ZONE=Asia/Shanghai

DB_NAME=personal_blog
DB_USER=blog
DB_PASSWORD=replace-with-a-unique-database-password

# Published in the logged-in service portal. Leave empty until your NAS URL is known.
NAS_URL=
BLOG_PORT=18081
BASE_REGISTRY=docker.m.daocloud.io/library
